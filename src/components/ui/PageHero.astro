---
import type { Crumb } from '../../lib/seo';

interface Props {
  crumbs: Crumb[];
  label: string;
  title: string;
  sheet: string;
  wide?: boolean;
}

const { crumbs, label, title, sheet, wide = false } = Astro.props;
---

<header class:list={['phero', { 'phero--wide': wide }]}>
  <div class="wrap">
    <div class="phero__bar">
      <nav class="phero__crumbs" aria-label="Breadcrumb">
        <ol role="list">
          {
            crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? (
                  <a href={c.href}>{c.name}</a>
                ) : (
                  <span aria-current="page">{c.name}</span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="phero__sheet label" aria-hidden="true">Sheet {sheet}</p>
    </div>

    <div class="phero__grid grid">
      <p class="phero__label label">{label}</p>
      <h1 class="phero__title"><Fragment set:html={title} /></h1>
      {
        Astro.slots.has('default') && (
          <div class="phero__lead">
            <slot />
          </div>
        )
      }
      {
        Astro.slots.has('aside') && (
          <div class="phero__aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  .phero {
    padding-top: var(--space-5);
    padding-bottom: var(--section-tight);
  }

  .phero__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line-strong);
  }

  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .phero__crumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.6rem;
    color: var(--line-strong);
  }

  .phero__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    text-decoration: none;
  }

  .phero__crumbs a:hover {
    color: var(--text);
  }

  .phero__crumbs [aria-current] {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text);
  }

  .phero__sheet {
    display: none;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .phero__grid {
    row-gap: var(--space-5);
    padding-top: var(--space-8);
  }

  .phero__label {
    grid-column: 1 / -1;
    color: var(--accent);
  }

  .phero__title {
    grid-column: 1 / -1;
    font-size: var(--fs-display-l);
    font-weight: 300;
    max-width: 13em;
  }

  .phero--wide .phero__title {
    max-width: 16em;
  }

  .phero__lead {
    grid-column: 1 / -1;
    font-size: var(--fs-lead);
    line-height: 1.42;
    max-width: 34em;
    color: var(--text-muted);
  }

  .phero__lead :global(.btn) {
    margin-top: var(--space-6);
  }

  .phero__aside {
    grid-column: 1 / -1;
  }

  @media (min-width: 40em) {
    .phero__sheet {
      display: block;
    }
  }

  @media (min-width: 64em) {
    .phero__grid {
      padding-top: var(--space-9);
    }

    .phero__label {
      grid-column: 1 / span 3;
      padding-top: 1.1em;
    }

    .phero__title {
      grid-column: 4 / -1;
    }

    .phero__lead {
      grid-column: 4 / span 6;
    }

    .phero__aside {
      grid-column: 4 / -1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .phero__title {
      animation: phero-in 900ms var(--ease-draft) both;
    }

    .phero__lead,
    .phero__aside {
      animation: phero-in 900ms var(--ease-out) 140ms both;
    }
  }

  @keyframes phero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1.25rem, 0);
    }
  }
</style>
