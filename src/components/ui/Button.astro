---
import type { HTMLAttributes } from 'astro/types';
import Arrow from './Arrow.astro';

type Variant = 'primary' | 'outline' | 'text';

type Props = {
  variant?: Variant;
  href?: string;
  arrow?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', href, arrow = true, class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, className];
---

{
  href ? (
    <a class:list={classes} href={href}>
      <span class="btn__text">
        <slot />
      </span>
      {arrow && <Arrow class="btn__arrow" />}
    </a>
  ) : (
    <button class:list={classes} {...rest}>
      <span class="btn__text">
        <slot />
      </span>
      {arrow && <Arrow class="btn__arrow" />}
    </button>
  )
}

<style>
  .btn {
    --tick: var(--text);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    min-height: 3.25rem;
    padding: 0 1.35rem;
    font-family: var(--sans);
    font-size: var(--fs-small);
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  /* Registration ticks: four corner marks close in on hover, like a frame locking. */
  .btn::before {
    content: '';
    position: absolute;
    inset: -6px;
    pointer-events: none;
    opacity: 0;
    transform: scale(1.08);
    background:
      linear-gradient(var(--tick), var(--tick)) top left / 9px 1px,
      linear-gradient(var(--tick), var(--tick)) top left / 1px 9px,
      linear-gradient(var(--tick), var(--tick)) top right / 9px 1px,
      linear-gradient(var(--tick), var(--tick)) top right / 1px 9px,
      linear-gradient(var(--tick), var(--tick)) bottom left / 9px 1px,
      linear-gradient(var(--tick), var(--tick)) bottom left / 1px 9px,
      linear-gradient(var(--tick), var(--tick)) bottom right / 9px 1px,
      linear-gradient(var(--tick), var(--tick)) bottom right / 1px 9px;
    background-repeat: no-repeat;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .btn:hover::before {
    opacity: 1;
    transform: scale(1);
  }

  .btn:hover :global(.btn__arrow) {
    transform: translateX(0.3rem);
  }

  .btn--primary {
    background-color: var(--text);
    color: var(--surface);
  }

  .btn--primary:hover {
    --tick: var(--accent);
    background-color: var(--accent);
  }

  .btn--outline {
    border: 1px solid var(--text);
    color: var(--text);
  }

  .btn--outline:hover {
    background-color: color-mix(in srgb, var(--text) 6%, transparent);
  }

  .btn--text {
    min-height: 2.75rem;
    padding: 0;
    gap: 0.8rem;
    color: var(--text);
  }

  .btn--text::before {
    display: none;
  }

  .btn--text .btn__text {
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    padding-bottom: 0.2em;
    transition: background-size var(--dur-3) var(--ease-draft);
  }

  .btn--text:hover .btn__text {
    background-size: 100% 1px;
  }

  .btn:focus-visible {
    outline-offset: 4px;
  }

  @media (forced-colors: active) {
    .btn {
      border: 1px solid ButtonText;
    }
  }
</style>
