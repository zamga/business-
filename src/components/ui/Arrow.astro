---
/** A drafting arrow: a dimension line with an open head. */
interface Props {
  class?: string;
  direction?: 'right' | 'down' | 'up-right';
}
const { class: className, direction = 'right' } = Astro.props;
---

<svg
  class:list={['arrow', `arrow--${direction}`, className]}
  viewBox="0 0 22 12"
  width="22"
  height="12"
  aria-hidden="true"
  focusable="false"
>
  <path d="M0 6h20.5M15.5 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.3" vector-effect="non-scaling-stroke"></path>
</svg>

<style>
  .arrow {
    flex: none;
    width: 1.375em;
    height: auto;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .arrow--down {
    rotate: 90deg;
  }

  .arrow--up-right {
    rotate: -45deg;
  }
</style>
