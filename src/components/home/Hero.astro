---
/**
 * The home hero. The BERGWEISS structure stands on the page as a physical
 * model; the headline is set over it. On landscape screens with a mouse the
 * model is live: the pointer moves the sun, as on an architect's heliodon.
 * Elsewhere a pre-rendered poster stands in, framed identically, and on a
 * first visit on phones a short film shows the structure assembling.
 * With reduced motion, no WebGL or Save-Data, the poster is the hero.
 */
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { models } from '../../data/models';
import { site } from '../../data/site';
import { STUDY_DATE, sunClock } from '../../lib/sun';

const axes = ['A', 'B', 'C', 'D', 'E'];
/** Poster lights, identical to the renders (scripts/render/render-media.mjs). */
const WIDE_SUN = 115;
const TALL_SUN = 150;

const wide = models.heroWide.src;
const tall = models.heroTall.src;
const set = (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  getImage({ src, widths, format, quality: format === 'avif' ? 62 : 74 });
const wideWidths = [960, 1440, 1920, 2400];
const tallWidths = [480, 720, 960, 1200];
const [wideAvif, wideWebp, tallAvif, tallWebp, fallback] = await Promise.all([
  set(wide, wideWidths, 'avif'),
  set(wide, wideWidths, 'webp'),
  set(tall, tallWidths, 'avif'),
  set(tall, tallWidths, 'webp'),
  getImage({ src: wide, width: 1440, format: 'webp', quality: 74 }),
]);
/** Portrait layouts (phones, tablets held upright) stack the model under the headline. */
const stacked = '(max-width: 39.99em), (max-aspect-ratio: 1/1)';
---

<section class="hero" data-hero data-cursor="sun" aria-labelledby="hero-title">
  <div class="wrap hero__wrap">
    <div class="hero__axes grid" aria-hidden="true">
      {
        axes.map((letter, i) => (
          <span class="axis" style={`--a:${i}`}>
            <span class="axis__bubble">{letter}</span>
          </span>
        ))
      }
    </div>

    <p class="hero__kicker label">{site.descriptor}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__line hero__line--1"><span class="hero__mask">Strategic decisions.</span></span>
      <span class="hero__line hero__line--2"><span class="hero__mask hero__italic">Precisely executed.</span></span>
    </h1>

    <div class="hero__stage" data-hero-stage aria-hidden="true">
      <picture class="hero__poster">
        <source media={stacked} type="image/avif" srcset={tallAvif.srcSet.attribute} sizes="100vw" />
        <source media={stacked} type="image/webp" srcset={tallWebp.srcSet.attribute} sizes="100vw" />
        <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes="100vw" />
        <img
          src={fallback.src}
          alt=""
          width={wide.width}
          height={wide.height}
          fetchpriority="high"
          decoding="async"
          data-wide-aspect={wide.width / wide.height}
        />
      </picture>
      <video class="hero__film" data-hero-film muted playsinline preload="none" tabindex="-1" disablepictureinpicture>
        <source src="/media/assembly-tall.webm" type="video/webm" />
        <source src="/media/assembly-tall.mp4" type="video/mp4" />
      </video>
      <canvas class="hero__canvas" data-hero-canvas></canvas>
    </div>

    <div class="hero__lower">
      <p class="hero__lead">
        M&amp;A advice for business owners, acquirers and investors navigating their next transaction.
      </p>
      <div class="hero__actions">
        <Button href="/contact/">Discuss a transaction</Button>
        <Button href="/expertise/" variant="outline">Explore our expertise</Button>
      </div>
    </div>

    <p class="hero__study label" aria-hidden="true">
      <span class="hero__study-ref">{models.heroWide.ref}</span>
      <span>Light study · {STUDY_DATE} · </span><span
        class="hero__clock"
        data-sun-time
        data-wide={sunClock(WIDE_SUN)}
        data-tall={sunClock(TALL_SUN)}><span class="hero__clock-wide">{sunClock(WIDE_SUN)}</span><span
          class="hero__clock-tall">{sunClock(TALL_SUN)}</span
        ></span>
      <span class="hero__hint">Move the pointer to move the sun</span>
    </p>
  </div>
</section>

<script>
  import '../../scripts/hero';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .hero__wrap {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--space-4) + 1.5rem + var(--space-6));
    padding-bottom: var(--space-7);
  }

  .hero__kicker,
  .hero__title,
  .hero__lower,
  .hero__study {
    position: relative;
    z-index: 1;
  }

  /* ----------------------------------------------------------- grid refs */
  .hero__axes {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--space-4) + 1.5rem + var(--space-5));
    padding-inline: var(--margin);
    max-width: var(--max);
    margin-inline: auto;
    pointer-events: none;
    z-index: 1;
    --ax-0: 1;
    --ax-1: 2;
    --ax-2: 3;
    --ax-3: 4;
  }

  .axis {
    position: relative;
    grid-row: 1;
    grid-column: var(--col) / span 1;
    justify-self: start;
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, var(--rule-strong), transparent);
  }

  .axis:nth-child(1) {
    --col: var(--ax-0);
  }

  .axis:nth-child(2) {
    --col: var(--ax-1);
  }

  .axis:nth-child(3) {
    --col: var(--ax-2);
  }

  .axis:nth-child(4) {
    --col: var(--ax-3);
  }

  .axis:nth-child(5) {
    grid-column: -2 / -1;
    justify-self: end;
  }

  .axis__bubble {
    position: absolute;
    top: var(--space-4);
    left: 50%;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: -0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--mineral);
    font-size: 0.625rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    color: var(--stone);
  }

  .axis:nth-child(1) .axis__bubble {
    left: 0;
  }

  .axis:nth-child(5) .axis__bubble {
    left: auto;
    right: 0;
    margin: 0 -0.75rem 0 0;
  }

  @media (min-width: 40em) {
    .hero__axes {
      --ax-1: 3;
      --ax-2: 5;
      --ax-3: 7;
    }
  }

  @media (min-width: 64em) {
    .hero__axes {
      --ax-1: 4;
      --ax-2: 7;
      --ax-3: 10;
    }
  }

  /* ----------------------------------------------------------- type */
  .hero__kicker {
    color: var(--stone);
  }

  .hero__title {
    --fs: var(--fs-hero);
    margin-top: var(--space-5);
    font-size: var(--fs);
    font-weight: 300;
    line-height: 0.93;
    letter-spacing: -0.024em;
    text-wrap: initial;
  }

  .hero__line {
    display: block;
  }

  .hero__line--2 {
    /* The second phrase starts on axis B. */
    padding-left: var(--b-offset, 0);
  }

  .hero__italic {
    font-style: italic;
    letter-spacing: -0.03em;
  }

  .hero__mask {
    display: inline-block;
  }

  .hero__lower {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .hero__lead {
    font-size: var(--fs-lead);
    line-height: 1.38;
    max-width: 24em;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__study {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5em;
    margin-top: var(--space-6);
    color: var(--stone);
    font-variant-numeric: tabular-nums;
  }

  .hero__study-ref {
    color: var(--accent);
  }

  .hero__hint {
    display: none;
    flex-basis: 100%;
    margin-top: 0.4em;
    color: var(--stone);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  :global(.is-live) .hero__hint {
    display: block;
  }

  .hero__clock-wide {
    display: none;
  }

  /* ----------------------------------------------------------- the model */
  .hero__stage {
    position: relative;
    order: 0;
    aspect-ratio: 4 / 5;
    margin: var(--space-6) calc(-1 * var(--margin)) 0;
    background: var(--mineral);
    pointer-events: none;
  }

  .hero__poster,
  .hero__poster img,
  .hero__film,
  .hero__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__poster img,
  .hero__film {
    object-fit: cover;
  }

  .hero__film,
  .hero__canvas {
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  :global(.is-filming) .hero__film,
  :global(.is-live) .hero__canvas {
    opacity: 1;
  }

  /* Under the intro overlay the model switches in at once. */
  :global(.is-instant) .hero__film,
  :global(.is-instant) .hero__canvas {
    transition: none;
  }

  @media (max-width: 39.99em) {
    .hero__title {
      --b-offset: 0;
    }

    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 40em) {
    .hero__title :global(.hero__line) {
      white-space: nowrap;
    }

    .hero__title {
      --b-offset: calc((100% - 7 * var(--gutter)) / 8 * 2 + 2 * var(--gutter));
    }

    .hero__stage {
      margin-inline: calc(-1 * var(--margin));
    }
  }

  @media (min-width: 64em) {
    .hero__title {
      --b-offset: calc((100% - 11 * var(--gutter)) / 12 * 3 + 3 * var(--gutter));
    }
  }

  /* Landscape: the model fills the hero and the type is set over it. */
  @media (min-width: 40em) and (min-aspect-ratio: 1/1) {
    .hero__wrap {
      min-height: max(36rem, calc(100svh - var(--header-h)));
      padding-top: calc(var(--space-4) + 1.5rem + var(--space-7));
    }

    .hero__stage {
      position: absolute;
      inset: 0;
      z-index: 0;
      margin: 0;
      aspect-ratio: auto;
    }

    .hero__title {
      --fs: clamp(3.5rem, 7.4vw, 9.5rem);
    }

    .hero__lower {
      margin-top: auto;
      padding-top: var(--space-7);
      max-width: 34rem;
    }

    .hero__study {
      position: absolute;
      right: var(--margin);
      bottom: var(--space-6);
      margin: 0;
      max-width: 18rem;
      justify-content: flex-end;
      text-align: right;
    }

    .hero__clock-wide {
      display: inline;
    }

    .hero__clock-tall {
      display: none;
    }
  }

  @media (min-width: 40em) and (min-aspect-ratio: 1/1) and (min-width: 110rem) {
    .hero__study {
      right: calc((100vw - var(--max)) / 2 + var(--margin));
    }
  }

  /* ----------------------------------------------------------- load sequence */
  @media (prefers-reduced-motion: no-preference) {
    .axis {
      animation: axis-draw var(--dur-4) var(--ease-draft) both;
      animation-delay: calc(var(--intro-delay) + var(--a) * 70ms);
      transform-origin: top center;
    }

    .axis__bubble {
      animation: fade-in var(--dur-3) var(--ease-out) both;
      animation-delay: calc(var(--intro-delay) + 200ms + var(--a) * 70ms);
    }

    .hero__line {
      overflow: clip;
      overflow-clip-margin: 0.2em;
      padding-bottom: 0.14em;
      margin-bottom: -0.14em;
    }

    .hero__mask {
      animation: rise 1100ms var(--ease-draft) both;
      animation-delay: var(--intro-delay);
    }

    .hero__line--2 .hero__mask {
      animation-delay: calc(var(--intro-delay) + 120ms);
    }

    .hero__kicker,
    .hero__lower,
    .hero__study {
      animation: fade-up 900ms var(--ease-out) both;
      animation-delay: var(--intro-delay);
    }

    .hero__lower {
      animation-delay: calc(var(--intro-delay) + 320ms);
    }

    .hero__study {
      animation-delay: calc(var(--intro-delay) + 900ms);
    }
  }

  @keyframes axis-draw {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes rise {
    from {
      transform: translate3d(0, 105%, 0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }
  }
</style>
