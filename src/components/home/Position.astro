---
import Button from '../ui/Button.astro';
import ModelFigure from '../media/ModelFigure.astro';
import TitleBlock from './TitleBlock.astro';
---

<section class="position section--tight" aria-labelledby="position-title">
  <div class="wrap grid position__grid">
    <span class="position__rule" data-reveal="line" aria-hidden="true"></span>
    <p class="position__label label"><span class="position__num">01</span> The firm</p>
    <h2 id="position-title" class="visually-hidden">The firm</h2>
    <p class="position__statement" data-reveal>
      Selling a company, acquiring one or bringing in new owners changes who owns what, usually for good. BERGWEISS
      advises business owners, acquirers and investors on these decisions, <em>and carries them through to completion.</em>
    </p>
    <ModelFigure
      class="position__plate"
      model="joint"
      ratio="4 / 5"
      focus="40% 50%"
      sizes="(min-width: 64em) 34vw, 100vw"
      caption="The brace, pinned into its corner. Execution is the member that makes a structure rigid."
    />
    <div class="position__aside" data-reveal style="--reveal-i: 1">
      <p class="position__note">
        Our role is advisory. We act for the client who appoints us; the capital in the transaction, and the decision to
        commit it, remain theirs.
      </p>
      <Button href="/firm/" variant="text">About the firm</Button>
    </div>
    <div class="position__block" data-reveal style="--reveal-i: 2">
      <TitleBlock />
    </div>
  </div>
</section>

<style>
  .position__grid {
    position: relative;
    row-gap: var(--space-6);
    padding-top: var(--space-5);
  }

  .position__rule {
    position: absolute;
    inset: 0 var(--margin) auto;
    height: 1px;
    background: var(--line-strong);
  }

  .position__label {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.9em;
    color: var(--text-muted);
  }

  .position__num {
    color: var(--accent);
  }

  .position__statement {
    grid-column: 1 / -1;
    font-family: var(--serif);
    font-size: var(--fs-statement);
    font-weight: 320;
    line-height: 1.16;
    letter-spacing: -0.016em;
    text-wrap: pretty;
  }

  .position__statement em {
    font-weight: 300;
  }

  :global(.position__plate) {
    grid-column: 1 / -1;
    margin-top: var(--space-5);
  }

  .position__aside {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 30rem;
  }

  .position__note {
    color: var(--text-muted);
  }

  .position__block {
    grid-column: 1 / -1;
  }

  @media (min-width: 40em) {
    :global(.position__plate) {
      grid-column: 1 / span 4;
      grid-row: span 2;
    }

    .position__aside,
    .position__block {
      grid-column: 5 / -1;
    }

    .position__aside {
      margin-top: var(--space-5);
    }

    .position__block {
      align-self: end;
    }
  }

  @media (min-width: 64em) {
    .position__label {
      grid-column: 1 / span 3;
      padding-top: 0.9em;
    }

    .position__statement {
      grid-column: 4 / -1;
    }

    :global(.position__plate) {
      grid-column: 1 / span 5;
      margin-top: var(--space-7);
    }

    .position__aside,
    .position__block {
      grid-column: 7 / -1;
    }

    .position__aside {
      margin-top: var(--space-7);
    }
  }
</style>
