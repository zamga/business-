---
/** The mark with one member emphasised: which part of the structure a step places. */
import type { MemberKey } from '../../data/approach';

interface Props {
  active: MemberKey;
  size?: string;
}

const { active, size = '2.25rem' } = Astro.props;
const frame: Array<{ key: MemberKey; x: number; y: number; w: number; h: number }> = [
  { key: 'beam', x: 0, y: 0, w: 100, h: 8 },
  { key: 'left', x: 0, y: 12, w: 8, h: 76 },
  { key: 'right', x: 92, y: 12, w: 8, h: 76 },
  { key: 'base', x: 0, y: 92, w: 100, h: 8 },
];
---

<svg class="smark" viewBox="-2 -2 104 104" width={size} height={size} aria-hidden="true" focusable="false">
  {
    frame.map((m) => (
      <rect
        class:list={['smark__m', { 'smark__m--on': m.key === active }]}
        x={m.x}
        y={m.y}
        width={m.w}
        height={m.h}
      />
    ))
  }
  <g transform="rotate(-45 50 50)">
    <rect
      class:list={['smark__m', 'smark__m--brace', { 'smark__m--on': active === 'brace' }]}
      x="0.5"
      y="46"
      width="99"
      height="8"
    />
  </g>
</svg>

<style>
  .smark {
    flex: none;
    overflow: visible;
  }

  .smark__m {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .smark__m--on {
    fill: var(--text);
    stroke: var(--text);
  }

  .smark__m--brace.smark__m--on {
    fill: var(--accent);
    stroke: var(--accent);
  }
</style>
