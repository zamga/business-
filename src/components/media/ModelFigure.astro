---
/**
 * A plate of model photography: the render, an optional plate head (reference
 * and title, as on a drawing sheet) and a caption. Revealed by a diagonal wipe
 * along the brace, the same motion as the page transition.
 */
import { Picture } from 'astro:assets';
import { models, type ModelKey } from '../../data/models';

interface Props {
  model: ModelKey;
  /** Responsive `sizes` for the layout slot the plate sits in. */
  sizes: string;
  caption?: string;
  /** Crop to an aspect ratio such as `16 / 9`; defaults to the render's own. */
  ratio?: string;
  /** `object-position` for the crop. */
  focus?: string;
  /** Show the plate reference and title above the image. */
  head?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { model, sizes, caption, ratio, focus = '50% 50%', head = true, loading = 'lazy', class: className } = Astro.props;
const photo = models[model];
const widths = [480, 800, 1200, 1600, 2000, 2400].filter((w) => w <= photo.src.width);
---

<figure class:list={['plate', className]} data-reveal="plate">
  {
    head && (
      <div class="plate__head label" aria-hidden="true">
        <span class="plate__ref">{photo.ref}</span>
        <span class="plate__title">{photo.title}</span>
      </div>
    )
  }
  <div class="plate__frame" style={`--ratio: ${ratio ?? `${photo.src.width} / ${photo.src.height}`}`}>
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      quality={72}
      loading={loading}
      decoding="async"
      class="plate__img"
      style={`object-position: ${focus}`}
    />
  </div>
  {caption && <figcaption class="plate__caption">{caption}</figcaption>}
</figure>

<style>
  .plate {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .plate__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-strong);
    color: var(--text-muted);
  }

  .plate__ref {
    color: var(--accent);
  }

  .plate__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--mineral);
  }

  .plate__frame :global(picture),
  .plate__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate__frame :global(img) {
    object-fit: cover;
  }

  .plate__caption {
    max-width: 36rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
