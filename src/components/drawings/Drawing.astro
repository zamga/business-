---
/**
 * Five original drawings, one per mandate, in architectural convention:
 * plans, elevations and sections in hairline ink, with the decisive element
 * in redline. Strokes do not scale, so lines stay hairline at any size.
 */
import type { drawingKeys } from '../../content.config';
import { contourPaths } from '../../lib/contours';

type Kind = (typeof drawingKeys)[number];

interface Props {
  kind: Kind;
  uid: string;
  class?: string;
}

const { kind, uid, class: className } = Astro.props;
const hatch = `hatch-${uid}`;
const hatchAccent = `hatch-a-${uid}`;
const earth = `earth-${uid}`;
const clip = `clip-${uid}`;

/** Chair symbol in plan: seat with a backrest line, facing `dir`. */
const chair = (x: number, y: number, dir: 'n' | 's' | 'e' | 'w') => {
  const w = dir === 'n' || dir === 's' ? 18 : 16;
  const h = dir === 'n' || dir === 's' ? 16 : 18;
  const back =
    dir === 'n'
      ? `M${x} ${y + h + 3}h${w}`
      : dir === 's'
        ? `M${x} ${y - 3}h${w}`
        : dir === 'e'
          ? `M${x - 3} ${y}v${h}`
          : `M${x + w + 3} ${y}v${h}`;
  return { rect: { x, y, width: w, height: h }, back };
};

const field: Array<{ x: number; y: number; state: 'dash' | 'solid' | 'gone' }> = [
  { x: 262, y: 64, state: 'dash' },
  { x: 302, y: 64, state: 'dash' },
  { x: 342, y: 64, state: 'solid' },
  { x: 262, y: 112, state: 'solid' },
  { x: 302, y: 112, state: 'dash' },
  { x: 342, y: 112, state: 'dash' },
  { x: 262, y: 160, state: 'dash' },
  { x: 302, y: 160, state: 'gone' },
  { x: 342, y: 160, state: 'solid' },
  { x: 262, y: 208, state: 'dash' },
  { x: 302, y: 208, state: 'dash' },
  { x: 342, y: 208, state: 'dash' },
];

const footprints: Array<{ x: number; y: number; w: number; h: number; state: 'line' | 'dash' }> = [
  { x: 52, y: 48, w: 62, h: 40, state: 'line' },
  { x: 134, y: 42, w: 44, h: 58, state: 'dash' },
  { x: 204, y: 54, w: 72, h: 34, state: 'line' },
  { x: 300, y: 44, w: 52, h: 52, state: 'dash' },
  { x: 48, y: 112, w: 40, h: 64, state: 'dash' },
  { x: 108, y: 124, w: 76, h: 44, state: 'line' },
  { x: 290, y: 122, w: 66, h: 38, state: 'dash' },
  { x: 146, y: 204, w: 40, h: 50, state: 'line' },
  { x: 214, y: 206, w: 72, h: 42, state: 'dash' },
  { x: 308, y: 192, w: 48, h: 60, state: 'line' },
];

/** Contour lines for the options site plan: a hill, generated, not traced. */
const contours = contourPaths({ cx: 300, cy: 92, levels: 7, base: 26, step: 24 });

const tick = (x: number, y: number) => `M${x - 3} ${y + 3}L${x + 3} ${y - 3}`;
---

<svg
  class:list={['drawing', `drawing--${kind}`, className]}
  viewBox="0 0 400 300"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id={hatch} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" class="pat"></line>
    </pattern>
    <pattern id={hatchAccent} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="5" class="pat pat--accent"></line>
    </pattern>
    <pattern id={earth} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="8" class="pat pat--faint"></line>
    </pattern>
    <clipPath id={clip}>
      <rect x="24" y="24" width="352" height="252"></rect>
    </clipPath>
  </defs>

  {
    kind === 'table' && (
      <>
        <g class="base">
          <rect class="l" x="56" y="118" width="132" height="64" />
          <rect class="l l--faint" x="62" y="124" width="120" height="52" />
          {[78, 113, 148].map((x) => {
            const top = chair(x, 94, 's');
            const bottom = chair(x, 190, 'n');
            return (
              <>
                <rect class="l" {...top.rect} />
                <path class="l" d={top.back} />
                <rect class="l" {...bottom.rect} />
                <path class="l" d={bottom.back} />
              </>
            );
          })}
          <rect class="f-ink" x="28" y="141" width="16" height="18" />
          <path class="l" d="M25 141v18" />
          {field.map((c) => {
            const s = chair(c.x, c.y, 'w');
            if (c.state === 'gone') return <rect class="l l--dash l--faint" {...s.rect} />;
            return (
              <>
                <rect class:list={['l', { 'l--dash l--faint': c.state === 'dash' }]} {...s.rect} />
                <path class:list={['l', { 'l--dash l--faint': c.state === 'dash' }]} d={s.back} />
              </>
            );
          })}
          <path class="l l--faint" d="M262 252H358" />
          <path class="l l--faint" d={tick(262, 252)} />
          <path class="l l--faint" d={tick(358, 252)} />
          <path class="l l--faint" d="M56 232H188" />
          <path class="l l--faint" d={tick(56, 232)} />
          <path class="l l--faint" d={tick(188, 232)} />
          <g class="scalebar">
            <rect class="f-ink" x="28" y="266" width="16" height="3" />
            <rect class="l" x="44" y="266" width="16" height="3" />
            <rect class="f-ink" x="60" y="266" width="16" height="3" />
            <rect class="l" x="76" y="266" width="16" height="3" />
          </g>
        </g>
        <g class="accent">
          <rect class="l l--accent" x="200" y="141" width="16" height="18" style={`fill:url(#${hatchAccent})`} />
          <path class="l l--accent" d="M219 141v18" />
          <path class="l l--accent l--dash" d="M302 169H236V150H222" />
        </g>
      </>
    )
  }

  {
    kind === 'targets' && (
      <>
        <g class="base">
          <rect class="l l--dashdot" x="24" y="24" width="352" height="252" />
          {footprints.map((f) => (
            <rect class:list={['l', { 'l--dash l--faint': f.state === 'dash' }]} x={f.x} y={f.y} width={f.w} height={f.h} />
          ))}
          <rect class="l" x="56" y="208" width="66" height="44" style={`fill:url(#${hatch})`} />
          <path class="l l--faint" d="M214 106H262" />
          <path class="l l--faint" d={tick(214, 106)} />
          <path class="l l--faint" d={tick(262, 106)} />
          <path class="l l--faint" d="M274 118V166" />
          <path class="l l--faint" d={tick(274, 118)} />
          <path class="l l--faint" d={tick(274, 166)} />
        </g>
        <g class="accent">
          <rect class="l l--accent" x="214" y="118" width="48" height="48" style={`fill:url(#${hatchAccent})`} />
          <path class="l l--accent l--dash" d="M89 208V192H238V166" />
          <circle class="f-accent" cx="89" cy="208" r="2.5" />
        </g>
      </>
    )
  }

  {
    kind === 'range' && (
      <>
        <g class="base">
          <path class="l" d="M28 250H372" />
          <rect x="28" y="250" width="344" height="12" style={`fill:url(#${earth})`} />
          <rect class="l" x="120" y="70" width="150" height="180" />
          {[106, 142, 178, 214].map((y) => (
            <path class="l l--faint" d={`M120 ${y}H270`} />
          ))}
          {[70, 106, 142, 178, 214].map((y) =>
            [136, 168, 200, 232].map((x) => <rect class="l l--faint" x={x} y={y + 10} width="18" height="16" />),
          )}
          {[70, 106, 142, 178, 214, 250].map((y) => (
            <>
              <path class="l l--faint" d={`M84 ${y}H112`} />
              <path class="l" d={`M92 ${y - 7}L98 ${y}L104 ${y - 7}Z`} />
            </>
          ))}
          <path class="l l--faint" d="M300 70V250" />
          {[70, 106, 142, 178, 214, 250].map((y) => (
            <path class="l l--faint" d={tick(300, y)} />
          ))}
        </g>
        <g class="accent">
          <path class="l l--accent" d="M332 106V178" />
          <path class="l l--accent" d="M326 106H338M326 178H338" />
          <path class="l l--accent l--dash" d="M270 128H332" />
          <path class="f-accent" d="M340 128l8-5v10z" />
        </g>
      </>
    )
  }

  {
    kind === 'options' && (
      <>
        <g class="base">
          <g clip-path={`url(#${clip})`}>
            {contours.map((d, i) => (
              <path class:list={['l', i % 3 === 2 ? 'l--mid' : 'l--faint']} d={d} />
            ))}
          </g>
          <rect class="l l--dashdot" x="24" y="24" width="352" height="252" />
          <path class="l l--dash" d="M116 104H264V146H186V222H116Z" />
          <rect class="l l--dash" x="136" y="92" width="150" height="34" />
          <rect class="l l--dash" x="136" y="188" width="150" height="34" />
          <g class="north">
            <circle class="l l--faint" cx="350" cy="250" r="11" />
            <path class="f-ink" d="M350 236l4 12h-8z" />
          </g>
        </g>
        <g class="accent">
          <path
            class="l l--accent"
            fill-rule="evenodd"
            style={`fill:url(#${hatchAccent})`}
            d="M164 120H262V212H164ZM188 144V188H238V144Z"
          />
        </g>
      </>
    )
  }

  {
    kind === 'section' && (
      <>
        <g class="base">
          <path class="l" d="M20 230H380" />
          <rect x="20" y="230" width="360" height="22" style={`fill:url(#${earth})`} />
          <rect class="l" x="92" y="64" width="8" height="166" style={`fill:url(#${hatch})`} />
          <rect class="l" x="300" y="64" width="8" height="166" style={`fill:url(#${hatch})`} />
          <rect class="f-ink" x="92" y="64" width="216" height="6" />
          <rect class="f-ink" x="92" y="114" width="216" height="5" />
          <rect class="f-ink" x="92" y="156" width="216" height="5" />
          <rect class="l l--dash l--faint" x="100" y="70" width="80" height="44" />
          <rect class="l l--dash l--faint" x="212" y="70" width="88" height="44" />
          <rect x="100" y="119" width="80" height="37" style={`fill:url(#${hatch})`} class="op-mid" />
          <rect x="212" y="119" width="88" height="37" style={`fill:url(#${hatch})`} class="op-mid" />
          <rect x="100" y="161" width="80" height="69" style={`fill:url(#${hatch})`} />
          <rect x="212" y="161" width="88" height="69" style={`fill:url(#${hatch})`} />
          <path class="l l--faint" d="M340 64V230" />
          {[64, 114, 156, 230].map((y) => (
            <path class="l l--faint" d={tick(340, y)} />
          ))}
          {[64, 114, 156, 230].map((y) => (
            <>
              <path class="l l--faint" d={`M56 ${y}H84`} />
              <path class="l" d={`M62 ${y - 7}L68 ${y}L74 ${y - 7}Z`} />
            </>
          ))}
        </g>
        <g class="accent">
          <rect class="l l--accent" x="182" y="64" width="28" height="166" />
          <path class="l l--accent" d="M182 114L210 156M210 114L182 156M182 164L210 222M182 70L210 108" />
        </g>
      </>
    )
  }
</svg>

<style>
  .drawing {
    width: 100%;
    height: auto;
    color: var(--text);
    overflow: visible;
  }

  .l {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-linecap: square;
  }

  .l--faint {
    stroke-opacity: 0.42;
  }

  .l--mid {
    stroke-opacity: 0.62;
  }

  .l--dash {
    stroke-dasharray: 3 3;
  }

  .l--dashdot {
    stroke-dasharray: 12 3 2 3;
    stroke-opacity: 0.6;
  }

  .l--accent {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .f-ink {
    fill: currentColor;
  }

  .f-accent {
    fill: var(--accent);
  }

  .op-mid {
    opacity: 0.55;
  }

  .pat {
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-opacity: 0.55;
  }

  .pat--accent {
    stroke: var(--accent);
    stroke-opacity: 0.9;
  }

  .pat--faint {
    stroke-opacity: 0.35;
  }

  .base,
  .accent {
    transition:
      opacity var(--dur-3) var(--ease-out),
      translate var(--dur-3) var(--ease-out);
  }
</style>
