---
/** A wide terrain of generated contour lines: the ground a transaction is built on. */
import { contourPaths } from '../../lib/contours';

interface Props {
  uid: string;
}

const { uid } = Astro.props;
const lines = [
  ...contourPaths({ cx: 1020, cy: 120, levels: 11, base: 18, step: 30, phase: 0.4 }),
  ...contourPaths({ cx: 260, cy: 470, levels: 7, base: 22, step: 34, drift: [8, -4], phase: 1.7 }),
];
const clip = `terrain-${uid}`;
---

<svg class="terrain" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={clip}><rect width="1440" height="560"></rect></clipPath>
  </defs>
  <g clip-path={`url(#${clip})`}>
    {lines.map((d, i) => <path d={d} class:list={['terrain__l', { 'terrain__l--index': i % 5 === 4 }]} />)}
  </g>
</svg>

<style>
  .terrain {
    width: 100%;
    height: 100%;
  }

  .terrain__l {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.09;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .terrain__l--index {
    stroke-opacity: 0.16;
  }
</style>
