# Canonical origin used for canonical URLs, Open Graph URLs and the sitemap.
# Required for production builds.
SITE_URL=https://www.example.com

# Endpoint that receives enquiry form submissions as multipart/form-data and
# answers with a 2xx status on success (for example a Formspree, Basin or
# Getform form endpoint, or your own API route). Leave empty to keep the form
# in its honest "not yet connected" state: nothing is sent and the visitor is
# told so.
PUBLIC_ENQUIRY_ENDPOINT=

# Set to "true" on preview deployments to render draft insights with a
# visible draft marker. Never set on production.
PUBLIC_SHOW_DRAFTS=false
